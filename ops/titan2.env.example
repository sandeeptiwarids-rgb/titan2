# /etc/titan2/titan2.env - the bot's secrets and switches (DETAIL 13.4). Written by hand from this file on the
# server; never committed, never copied by deploy or backup. Install it as root:titan 0640:
#   sudo install -m 0640 -o root -g titan /dev/null /etc/titan2/titan2.env && sudoedit /etc/titan2/titan2.env
# Read by titan2-bot, titan2-token, titan2-selfcheck and titan2-alert@ (systemd EnvironmentFile) and by the titan2
# CLI (sudo -u titan). Format: KEY=value per line; quote a value with single quotes if it contains $ or spaces.
#
# Deliberately absent: the Kite access token (it lives in /var/lib/titan2/session/kite_session.json, written only
# by titan2-token) and any TRADING_MODE (modes are per strategy in the DB; LIVE needs ALLOW_LIVE=1 plus the
# G1-bound unlock). The self-check fails if this file holds ZERODHA_ACCESS_TOKEN or TRADING_MODE.

# Zerodha Kite Connect app and login (the headless TOTP login of titan2-token)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_USER_ID=
ZERODHA_PASSWORD=
ZERODHA_TOTP_SECRET=

# auto: titan2-token logs in at 08:30 with the password and TOTP. manual: it sends the Kite login URL to Telegram
# and you run `titan2 token --request-token <rt>` on the server.
TOKEN_MODE=auto

# Key 1 of 2 for LIVE (DETAIL 10.8). Keep 0 until a strategy holds a G1 certificate and you mean to trade money.
ALLOW_LIVE=0

# The Elastic IP registered in the Kite developer console (SEBI static-IP rule [V]). LIVE stays off on any day the
# egress IP differs; required when ALLOW_LIVE=1.
REGISTERED_EGRESS_IP=

# Alerts: Telegram bot and chat; the healthchecks.io check URL for the dead-man ping
# (schedule 45-59 8 * * 1-5, * 9-14 * * 1-5 and 0-33 15 * * 1-5, Asia/Kolkata, 3 minutes grace:
# titan2.alerts.DEADMAN_SCHEDULE).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional phone alerts through the ntfy app (https://ntfy.sh): a long random topic name, kept private
NTFY_TOPIC=
HEALTHCHECK_URL=

# Optional: the NSE F&O ban-list CSV URL (default built in), and an S3 prefix for ops/backup.sh (instance role).
#BAN_LIST_URL=
#BACKUP_S3_URI=
