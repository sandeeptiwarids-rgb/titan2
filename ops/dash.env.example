# /etc/titan2/dash.env - the dashboard's own secrets, and nothing else (DETAIL 12.2, 13.4). Install as
# root:titandash 0640:
#   sudo install -m 0640 -o root -g titandash /dev/null /etc/titan2/dash.env && sudoedit /etc/titan2/dash.env
# It must never contain a ZERODHA_* key: the dashboard has no broker credentials (the self-check and the app
# both refuse). Generate the values on the server with the current release:
#   cd /home/ubuntu/titan/agentic_trader
#   /home/ubuntu/titan/current/venv/bin/python -m titan2.dash.app hash-password   # prints DASH_PASS_SCRYPT='...'
#   /home/ubuntu/titan/current/venv/bin/python -m titan2.dash.app new-secret      # prints DASH_SECRET=...
# Keep the single quotes around DASH_PASS_SCRYPT: the value contains '$'.
DASH_USER=
DASH_PASS_SCRYPT=
DASH_SECRET=
