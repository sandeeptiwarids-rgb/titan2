# %APPDATA%\titan2\titan2.env - titan2's secrets on the Windows laptop (PAPER only; docs/LAPTOP.md).
# ops\windows\setup.ps1 copies this file there once (never over an existing file) and makes it readable by you only
# (icacls). It lives outside the repo: never copy it into git, a chat, an email or a cloud drive.
# Edit it with Notepad:  notepad "$env:APPDATA\titan2\titan2.env"   (Notepad saves UTF-8, which titan2 needs.)
#
# Format: KEY=value, one per line, the value right after '=' and nothing after it (no comment on a value line).
# No quotes are needed, even when a value contains $, # or spaces.
#
# Your old v1 values: the file agentic_trader/.env inside
#   %USERPROFILE%\MCX\_titan_ec2_backup\titan_backup_2026-06-10.tgz
# (open the .tgz in File Explorer or 7-Zip; do not extract it into the repo). v1 used the same five ZERODHA_ names
# as below: copy those five lines only, never ZERODHA_ACCESS_TOKEN, PAPER_MODE or any other v1 line. If you rotated a
# secret since (docs/RUNBOOK.md section 8, Stage 0 step 4), use the new value. v1 had no Telegram keys.
#
# Deliberately absent: the Kite access token (titan2 logs in each morning and keeps the session in
# %LOCALAPPDATA%\titan2\var\session\kite_session.json), any trading mode, and ALLOW_LIVE / REGISTERED_EGRESS_IP:
# the laptop refuses LIVE whatever this file says.

# Kite Connect app (developers.kite.trade -> your app): its API key and API secret. Needed every day.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# Your Zerodha client id (the login id, like AB1234). Needed every day.
ZERODHA_USER_ID=

# The automatic morning login: your Kite password and your TOTP secret (the text key behind the 2FA QR code, not a
# 6-digit code). Leave both empty to log in by hand each morning: titan2 then shows the Kite login link and asks for
# the request token.
ZERODHA_PASSWORD=
ZERODHA_TOTP_SECRET=

# Optional: Telegram alerts and the daily report (a bot made with @BotFather, and your chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Phone alerts through the free ntfy app (https://ntfy.sh): a long random topic name, kept private
NTFY_TOPIC=

# Recommended: the dead-man. A free healthchecks.io check (schedule 15-59 9 * * 1-5, * 10-14 * * 1-5 and
# 0-33 15 * * 1-5, time zone Asia/Kolkata, 3 minutes grace: titan2.alerts.LAPTOP_DEADMAN_SCHEDULE) with its ntfy
# integration rings your phone when titan2 stops pinging it (the laptop slept, lost power, or titan2 stopped). It
# begins at 09:15 because titan2 pings first once it is ready, a few minutes after you start it (08:40 to 09:10).
# Its ping URL goes here; keep it private. Pause the check on NSE holidays (healthchecks cannot know them), and
# when you stop titan2 before 15:33 pause it after titan2 has stopped, within a minute (not before: titan2 pings
# it while it stops); its next ping resumes it.
HEALTHCHECK_URL=
